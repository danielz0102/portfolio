---
import type { HTMLAttributes } from "astro/types"

interface Props extends Omit<HTMLAttributes<"a">, "href"> {
	href: string
}

const { class: className, href, ...props } = Astro.props
---

<!-- biome-ignore lint/a11y/useAnchorContent: Content comes from the default slot -->
<a
	href={href}
	{...props}
	class:list={[className, "inline-flex items-center gap-2 no-underline text-inherit bg-surface px-4 py-2 rounded hover:opacity-75"]}
>
	<slot />
</a>
