---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
import type { AstroComponentFactory } from "astro/runtime/server/index.js"
import type { Translations } from "../i18n"
import ExternalLink from "../icons/ExternalLink.astro"
import GitHub from "../icons/GitHub.astro"
import Link from "./Link.astro"

interface Props {
	title: string
	description: string
	image: {
		data: ImageMetadata
	}
	stack: { name: string; Icon: AstroComponentFactory }[]
	preview: string
	github: string
	t: Translations
}

const { title, description, image, stack, preview, github, t } = Astro.props
---

<article class="flex flex-col gap-4 rounded">
	<h3 class="text-3xl">{title}</h3>
	<Image src={image.data} alt="" class="max-h-100 object-cover rounded" />
	<ul class="flex flex-wrap gap-4">
		{stack.map(({ name, Icon }) => (
			<li class="flex items-center gap-1">
				<Icon />
				<span>{name}</span>
			</li>
		))}
	</ul>
	<p class="text-foreground-secondary">{description}</p>
	<footer class="flex items-center gap-4">
		<Link href={github} target="_blank" rel="noreferrer">
			<GitHub />
			{t.repository}
		</Link>
		<Link href={preview} target="_blank" rel="noreferrer">
			<ExternalLink />
			{t.preview}
		</Link>
	</footer>
</article>
