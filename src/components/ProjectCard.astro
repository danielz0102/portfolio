---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"
import type { AstroComponentFactory } from "astro/runtime/server/index.js"
import type { Translations } from "../i18n"
import ExternalLink from "../icons/ExternalLink.astro"
import GitHub from "../icons/GitHub.astro"

interface Props {
	title: string
	description: string
	image: {
		data: ImageMetadata
		left?: boolean
	}
	stack: { name: string; Icon: AstroComponentFactory }[]
	preview: string
	github: string
	t: Translations
}

const { title, description, image, stack, preview, github, t } = Astro.props
---

<article>
	<h3>{title}</h3>
	<Image
		src={image.data}
		alt=""
		class:list={["cover", image.left && "left" ]}
	/>
	<ul class="stack">
		{stack.map(({ name, Icon }) => (
			<li>
				<Icon />
				<span>{name}</span>
			</li>
		))}
	</ul>
	<p>{description}</p>
	<footer>
		<a class="link" href={github} target="_blank" rel="noreferrer">
			<GitHub />
			GitHub
		</a>
		<a class="link" href={preview} target="_blank" rel="noreferrer">
			<ExternalLink />
			{t.preview}
		</a>
	</footer>
</article>

<style>
	h3 {
		font-size: 1.5rem;
		font-weight: 500;
	}

	article {
		display: flex;
		flex-direction: column;
		gap: 16px;
		border-radius: 4px;
	}

	.stack {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		padding: 0;

		& > li {
			display: flex;
			align-items: center;
			gap: 4px;
		}
	}

	.cover {
		max-height: 400px;
		object-fit: cover;
		border-radius: 8px;
	}

	.left {
		object-position: 0% 0%;
	}

	p {
		color: var(--text-secondary);
	}

	footer {
		display: flex;
		align-items: center;
		gap: 16px;
	}
</style>
