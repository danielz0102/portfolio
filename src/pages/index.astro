---
import Layout from "../layouts/Layout.astro"
import Introduction from "../sections/Introduction.astro"
---

<Layout>
	<main>
		<div>
			<Introduction />
		</div>
	</main>
</Layout>

<style>
	main {
		& > div {
			display: flex;
			flex-direction: column;
			gap: 16px;
		}

		@media (width >= 600px) {
			max-width: 600px;
			margin-inline: auto;
		}
	}

	h2 {
		color: var(--text-secondary);
	}
</style>
