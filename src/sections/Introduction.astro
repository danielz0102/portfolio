---
import type { Translations } from "../i18n"
import GitHub from "../icons/GitHub.astro"
import Mexico from "../icons/Mexico.astro"
import TypeScript from "../icons/TypeScript.astro"

interface Props {
	t: Translations
}

const { t } = Astro.props
---

<section>
	<hgroup>
		<h1>Daniel Zambrano</h1>
		<p>{t.jobTitle}</p>
	</hgroup>
	<p>
		{t.intro1}
		<span class="icon typescript">
			<TypeScript />
		</span>
		{t.intro2} <span class="icon"><Mexico /></span> {t.intro3}
	</p>
	<footer>
		<a
			href="https://github.com/danielz0102"
			target="_blank"
			rel="noreferrer"
			class="link"
		>
			<GitHub />
			GitHub
		</a>
	</footer>
</section>

<style>
	section {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	h1 {
		font-size: clamp(2.25rem, 5vw, 3rem);
	}

	hgroup p {
		color: var(--text-secondary);
	}

	.icon {
		display: inline-block;
		vertical-align: bottom;
	}

	.typescript {
		padding: 4px 8px;
	}
</style>
