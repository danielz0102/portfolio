---
import Email from "../components/Email.astro"
import Link from "../components/Link.astro"
import type { Translations } from "../i18n"
import GitHub from "../icons/GitHub.astro"
import Mexico from "../icons/Mexico.astro"
import TypeScript from "../icons/TypeScript.astro"

interface Props {
	t: Translations
}

const { t } = Astro.props
---

<section class="flex flex-col gap-4">
	<hgroup>
		<h1 class="text-[clamp(2.25rem,5vw,3rem)] font-bold">Daniel Zambrano</h1>
		<p class="text-foreground-secondary">{t.jobTitle}</p>
	</hgroup>
	<p>
		{t.intro1}
		<span class="inline-block align-bottom px-2">
			<Mexico />
		</span>
		{t.intro2}
		<span class="inline-block align-bottom px-2">
			<TypeScript />
		</span>
		{t.intro3}
	</p>
	<footer class="flex flex-wrap items-center gap-2">
		<Link
			href="https://github.com/danielz0102"
			target="_blank"
			rel="noreferrer"
		>
			<GitHub />
			GitHub
		</Link>
		<Email t={t} />
	</footer>
</section>
