---
import GitHub from "../icons/GitHub.astro"
import Mexico from "../icons/Mexico.astro"
import TypeScript from "../icons/TypeScript.astro"
---

<section>
	<hgroup>
		<h1>Daniel Zambrano</h1>
		<p>Software Developer</p>
	</hgroup>
	<p>
		I built frontend and backend applications with
		<span class="icon typescript">
			<TypeScript size={20} />
		</span>
		TypeScript. I'm from México <span class="icon"><Mexico /></span> and I love
		computer science and software engineering.
	</p>
	<footer>
		<a
			href="https://github.com/danielz0102"
			target="_blank"
			rel="noreferrer"
			class="link"
		>
			<GitHub />
			GitHub
		</a>
	</footer>
</section>

<style>
	section {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	hgroup p {
		color: var(--text-secondary);
	}

	.icon {
		display: inline-block;
		vertical-align: bottom;
	}

	.typescript {
		padding: 4px;
	}
</style>
