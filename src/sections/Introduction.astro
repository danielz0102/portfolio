---
import GitHub from "../icons/GitHub.astro"
import Mexico from "../icons/Mexico.astro"
import TypeScript from "../icons/TypeScript.astro"
---

<section>
	<hgroup>
		<h1>Daniel Zambrano</h1>
		<p>Software Developer</p>
	</hgroup>
	<p>
		I built frontend and backend applications with
		<span class="tag">
			<TypeScript size={16} />
			TypeScript
		</span>. I'm from México <span class="icon"><Mexico /></span> and I love
		computer science and software engineering.
	</p>
	<footer>
		<a
			href="https://github.com/danielz0102"
			target="_blank"
			rel="noreferrer"
			class="link"
		>
			<GitHub />
			GitHub
		</a>
	</footer>
</section>

<style>
	section {
		display: flex;
		flex-direction: column;
		gap: 16px;
	}

	hgroup p {
		color: var(--text-secondary);
	}

	.icon {
		display: inline-block;
		vertical-align: bottom;
	}

	.tag {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		margin-left: 2px;
		padding-inline: 4px 8px;
		border-radius: 4px;
		font-size: 0.9rem;
		background-color: #c6d8eb;
		color: #032b56;
		border: 1px solid #3178c6;
	}

	.link {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		text-decoration: none;
		color: inherit;
	}
</style>
