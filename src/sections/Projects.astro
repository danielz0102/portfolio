---
import cleverCss from "../assets/clever-css.png"
import linku from "../assets/linku.png"
import shingekiMemo from "../assets/shingeki-memo.webp"
import ProjectCard from "../components/ProjectCard.astro"
import type { Translations } from "../i18n"
import Express from "../icons/Express.astro"
import Postgre from "../icons/Postgre.astro"
import React from "../icons/React.astro"
import Redis from "../icons/Redis.astro"
import SocketIo from "../icons/SocketIo.astro"
import TailwindCSS from "../icons/Tailwind.astro"
import TypeScript from "../icons/TypeScript.astro"
import Vitest from "../icons/Vitest.astro"
import VsCode from "../icons/VsCode.astro"

interface Props {
	t: Translations
}

const { t } = Astro.props
---

<section>
	<h2>{t.projects}</h2>
	<div>
		<ProjectCard
			title="Clever CSS"
			description={t.cleverCSSDesc}
			image={{data: cleverCss }}
			github="https://github.com/danielz0102/clever-css"
			preview="https://marketplace.visualstudio.com/items?itemName=daniel-zambrano.clever-css"
			stack={[
				{name: "TypeScript", Icon: TypeScript},
				{name: "VS Code Extension Framework", Icon: VsCode},
			]}
			t={t}
		/>
		<ProjectCard
			title="Linku"
			description={t.linkuDesc}
			image={{data: linku, left: true}}
			github="https://github.com/danielz0102/linku"
			preview="https://linku-web-eight.vercel.app/"
			stack={[
				{name: "React", Icon: React},
				{name: "TypeScript", Icon: TypeScript},
				{name: "TailwindCSS", Icon: TailwindCSS},
				{name: "PostgreSQL", Icon: Postgre},
				{name: "Redis", Icon: Redis},
				{name: "Express", Icon: Express},
				{name: "Socket.IO", Icon: SocketIo},
				{name: "Vitest", Icon: Vitest},
			]}
			t={t}
		/>
		<ProjectCard
			title="Shingeki Memo"
			description={t.shingekiMemoDesc}
			image={{data: shingekiMemo }}
			github="https://github.com/danielz0102/shingeki-memo"
			preview="https://shingeki-memo.vercel.app/"
			stack={[
				{name: "React", Icon: React},
			]}
			t={t}
		/>
	</div>
</section>

<style>
	h2 {
		font-size: 2rem;
		margin-bottom: 8px;
	}

	div {
		display: flex;
		flex-direction: column;
		gap: 32px;
	}
</style>
