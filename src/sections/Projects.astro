---
import linku from "../assets/linku.png"
import shingekiMemo from "../assets/shingeki-memo.jpeg"
import ProjectCard from "../components/ProjectCard.astro"
---

<section>
	<h2>Projects</h2>
	<ProjectCard
		title="Linku"
		description="Chat app with authentication, profile customization, and real-time text and image messaging."
		image={{data: linku, left: true}}
		github="https://github.com/danielz0102/linku"
		preview="https://linku-web-eight.vercel.app/"
	/>
	<ProjectCard
		title="Shingeki Memo"
		description="Attack on Titan anime memory card game."
		image={{data: shingekiMemo }}
		github="https://github.com/danielz0102/shingeki-memo"
		preview="https://shingeki-memo.vercel.app/"
	/>
</section>

<style>
	h2 {
		font-size: 2rem;
	}

	section {
		display: flex;
		flex-direction: column;
		gap: 32px;
	}
</style>
